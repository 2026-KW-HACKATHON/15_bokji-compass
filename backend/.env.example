# setup.ps1 / setup.sh copies this file only when .env does not exist.
APP_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# JSON array; add your frontend development origin when needed.
CORS_ORIGINS=[]

# Auth: password login and optional Kakao web login. Phone verification is removed.
AUTH_ENABLED=true
# Default member storage when DB_ENABLED=false; created automatically on first login request.
AUTH_SQLITE_PATH=data/auth.sqlite3
# Password signup requires SMTP email verification. Keep credentials server-only.
# Port 587 normally uses starttls; port 465 uses ssl. Both verify the TLS certificate.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# A single sender address authorized by your mail provider (no display name).
SMTP_FROM_EMAIL=
# Kakao credentials are server-only.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Register this exact URI in Kakao Developers; keep the web and callback same-origin.
KAKAO_REDIRECT_URI=http://127.0.0.1:5173/api/v1/auth/kakao/callback
KAKAO_WEB_URL=http://127.0.0.1:5173/

# Disabled until scripts/setup-mysql.ps1 or manual configuration succeeds.
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=bokji_compass_dev
DB_USER=bokji_dev
DB_PASSWORD=
DB_SSL_CA=
# Validated new policy revisions are published automatically. false keeps manual review.
POLICY_AUTO_PUBLISH=true

# 행정안전부 보조금24 공공데이터포털 Open API 일반 인증키
# 데이터명: 행정안전부_대한민국 공공서비스(혜택) 정보
# https://www.data.go.kr/data/15113968/openapi.do
DATA_GO_KR_API_KEY=

# 보건복지부 복지로 공공데이터포털 Open API 일반 인증키
# 데이터명: 한국사회보장정보원_중앙부처복지서비스
# https://www.data.go.kr/data/15090532/openapi.do
BokjiRO_API_KEY=

# 공개 복지 원문 분석용 Codex CLI. 팀원별 codex login 필요.
# 비우면 Windows native codex.exe / macOS PATH의 codex 검색. 직접 지정 시 절대 경로 사용.
CODEX_EXECUTABLE=
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=medium
# 형식/근거 검증 실패 때 한 번 재시도할 모델. 빈 값이면 재시도 없음.
CODEX_FALLBACK_MODEL=gpt-5.6-terra
CODEX_TIMEOUT_SECONDS=300
PARSING_MAX_INPUT_CHARS=60000

# 서버 수집: FastAPI 실행만으로 수집하지 않습니다. tick --live 또는 서버 스케줄을 사용합니다.
# 호출 한도는 실제 계정 한도를 확인하기 전의 보수적인 설정이며 실패/재시도도 차감합니다.
# false이면 새 수집 회차를 중지합니다. 진행 중인 회차는 원래 제한 시간 안에 종료합니다.
INGESTION_ENABLED=true
INGESTION_PAGE_SIZE=50
INGESTION_MAX_PAGES=3
INGESTION_MAX_JOBS=5
INGESTION_MAX_SECONDS=600
INGESTION_MAX_HTTP_CALLS=10
INGESTION_HTTP_INTERVAL_SECONDS=2
INGESTION_MAX_RESPONSE_BYTES=2000000
INGESTION_MAX_MODEL_CALLS=4
# CLI가 보고한 사용량으로 다음 호출을 제한합니다. 한 호출의 토큰 상한은 아닙니다.
INGESTION_MAX_TOKENS=100000
INGESTION_DAILY_MODEL_CALLS=20
INGESTION_DAILY_BOKJIRO_CALLS=60
INGESTION_DAILY_GOV24_CALLS=200
INGESTION_DAILY_NOTICE_CALLS=20
INGESTION_SCAN_INTERVAL_SECONDS=86400
INGESTION_RECHECK_SECONDS=86400
INGESTION_QUEUE_LIMIT=200
INGESTION_MAX_ATTEMPTS=3
INGESTION_MIN_AVAILABLE_MEMORY_MB=512
INGESTION_MIN_FREE_DISK_MB=512
# 외부 공고 검색은 후보만 저장합니다. 원문 수집은 queue-candidate로 명시합니다.
INGESTION_DISCOVERY_ENABLED=false
INGESTION_DISCOVERY_DOMAINS=["youth.seoul.go.kr","www.nowon.kr"]
INGESTION_DISCOVERY_QUERY=서울 노원구 복지 지원금 장학금 주거 지원 참여자 모집 공고
