# setup.ps1 copies this file only when .env does not exist.
APP_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# JSON array; add your frontend development origin when needed.
CORS_ORIGINS=[]

# Disabled until scripts/setup-mysql.ps1 or manual configuration succeeds.
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=bokji_compass_dev
DB_USER=bokji_dev
DB_PASSWORD=
DB_SSL_CA=

# Gov24 public API key; never commit a real key.
DATA_GO_KR_API_KEY=
