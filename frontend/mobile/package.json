{
  "name": "bokji-compass-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "decode-uri-component": "file:../packages/decode-uri-component-compat",
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "@bokji/core": "file:../packages/core"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-local.ps1",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --test tests/*.test.mjs",
    "export:native": "expo export --platform android --platform ios",
    "export:web": "expo export --platform web"
  },
  "private": true,
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "xcode": { "uuid": "11.1.1" }
  }
}
