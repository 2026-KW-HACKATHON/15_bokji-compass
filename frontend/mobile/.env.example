# Public address only. Never put API secrets in EXPO_PUBLIC variables.
# Direct backend: https://your-api-host ; reverse proxy: https://your-host/api
EXPO_PUBLIC_API_BASE_URL=https://bokji.commitnaru.com/api

# Public EAS project UUID for Expo push enrollment (not a secret).
EXPO_PUBLIC_EAS_PROJECT_ID=
# Local path to your Firebase Android google-services.json. Do not commit the file.
BOKJI_GOOGLE_SERVICES_FILE=
