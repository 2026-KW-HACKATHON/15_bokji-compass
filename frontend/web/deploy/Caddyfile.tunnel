{
	admin off
	auto_https off
}

http://:8080 {
	bind 127.0.0.1
	root * "__DIST_ROOT__"
	header {
		X-Content-Type-Options nosniff
		?Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Cross-Origin-Resource-Policy same-origin
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://t1.kakaocdn.net; script-src-attr 'none'; frame-src https://postcode.map.kakao.com https://postcode.map.daum.net; style-src 'self'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
	}
	request_body {
		max_size 256KB
	}
	# Cloudflare overwrites this header with the visitor's actual protocol.
	# Trust it only on this loopback listener behind the managed tunnel.
	@insecurePublic {
		not header X-Forwarded-Proto https
		# Direct loopback checks have no tunnel metadata; forwarded HTTP is never exempt.
		not {
			host localhost 127.0.0.1 [::1]
			not header X-Forwarded-Proto *
			not header CF-Connecting-IP *
		}
	}
	# Keep this before every content handle, including the API and QR gateway.
	handle @insecurePublic {
		header Cache-Control no-store
		@navigation {
			method GET HEAD
			not path /api /api/*
		}
		redir @navigation https://{host}{uri} 308
		# Never redirect credentials/bodies or process any API request over HTTP.
		respond "HTTPS is required." 403
	}
	handle /app-config.js {
		header Content-Type application/javascript
		header Cache-Control no-store
		respond "window.__BOKJI_CONFIG__ = {dataMode:'api',apiBaseUrl:'/api'};"
	}
	handle /admin/exhibition {
		redir /admin/exhibition/ 302
	}
	handle_path /admin/exhibition/* {
		reverse_proxy 127.0.0.1:5181
	}
	handle /downloads/bokji-compass.apk {
		header Content-Type application/vnd.android.package-archive
		header Content-Disposition "attachment; filename=bokji-compass.apk"
		header Cache-Control no-store
		file_server
	}
	handle_path /api/* {
		@publicApi path /v1/local-services /health /health/ready /v1/policies /v1/policies/* /v1/recommendations /v1/assistant/faqs /v1/assistant/questions /v1/assistant/chat/dialogue /v1/assistant/dialogue /v1/assistant/dialogue/profile /v1/monitoring /v1/monitoring/* /v1/auth/* /v1/finance/* /v1/admin/session /v1/admin/accounts /v1/admin/policies /v1/admin/policies/* /v1/mobile/auth/login /v1/mobile/auth/me /v1/mobile/auth/logout /v1/mobile/auth/signup /v1/mobile/auth/email/request /v1/mobile/auth/email/verify /v1/mobile/auth/kakao/start /v1/mobile/auth/kakao/authorize /v1/mobile/auth/kakao/exchange /v1/mobile/auth/kakao/complete /v1/mobile/auth/kakao/cancel /v1/mobile/auth/kakao/cancel-signup /v1/mobile/notifications/preferences /v1/mobile/notifications/devices /v1/mobile/notifications/devices/disable
		handle @publicApi {
			reverse_proxy 127.0.0.1:8001 {
				header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
				header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
				header_down Set-Cookie "^(.*)$" "$1; Secure"
				transport http {
					dial_timeout 5s
					response_header_timeout 75s
				}
			}
		}
		handle {
			respond 404
		}
	}
	@entryDocument path / /index.html
	handle @entryDocument {
		request_header -If-None-Match
		request_header -If-Modified-Since
		header {
			Cache-Control no-store
			-ETag
			-Last-Modified
		}
		file_server
	}
	handle {
		header Cache-Control no-cache
		file_server
	}
}
